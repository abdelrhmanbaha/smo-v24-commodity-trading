classDiagram
    direction LR

    namespace model {
        class Source {
            -int id
            -String name
            -double minInterval
            -double maxInterval
            -double nextArrivalTime
            +generateNextRequest() Request
            -drawInterval() double
            +getPriority() int
        }

        class Request {
            -int sourceId
            -int sequenceNumber
            -double generationTime
            -RequestStatus status
            -double serviceStartTime
            -double serviceEndTime
            +markServiceStarted(double time)
            +markServed(double time)
            +markRefused(double time)
            +getWaitingTime() double
            +getTimeInSystem() double
        }

        class Device {
            -int id
            -double serviceRate
            -DeviceStatus status
            -Request currentRequest
            -double serviceEndTime
            -double totalBusyTime
            +startService(Request request, double now) double
            +completeService() Request
            -drawServiceTime() double
            +isFree() boolean
        }

        class RequestStatus {
            <<enumeration>>
            WAITING
            IN_SERVICE
            SERVED
            REFUSED
        }

        class DeviceStatus {
            <<enumeration>>
            FREE
            BUSY
        }
    }

    namespace buffer {
        class Buffer {
            -Request[] slots
            +placeRequest(Request request) boolean
            +remove(Request request)
            +findLowestPriorityRequest() Request
            +highestPrioritySourcePresent() OptionalInt
            +removeAllFromSource(int sourceId) List~Request~
            +isFull() boolean
            +isEmpty() boolean
        }
    }

    namespace dispatcher {
        class SelectionDispatcher {
            <<ДВ>>
            -Buffer buffer
            -Device[] devices
            -int devicePointer
            -Deque~Request~ currentBatch
            -int currentBatchSourceId
            -Set~Device~ batchDevices
            +tryServeDirectly(Request request) boolean
            +onDeviceFree(Device device, double now) List~Request~
            -isBatchActive() boolean
            -formNewBatch()
            -dispatchBatch(double now) List~Request~
            -selectFreeDevice() Device
            -advancePointer(int chosenIndex)
        }

        class PlacementDispatcher {
            <<ДП>>
            -Buffer buffer
            +onRequestArrival(Request request) Optional~Request~
            -applyRefusalDiscipline(double now) Request
        }
    }

    namespace statistics {
        class Statistics {
            -SourceCounters[] perSource
            +recordArrival(Request request)
            +recordServiceStart(Request request)
            +recordServiceEnd(Request request)
            +recordRefusal(Request request)
            +refusalProbability(int sourceId) double
            +meanTimeInSystem(int sourceId) double
            +meanWaitingTime(int sourceId) double
            +meanServiceTime(int sourceId) double
            +waitingTimeVariance(int sourceId) double
            +serviceTimeVariance(int sourceId) double
            +utilization(Device device, double totalRunTime)$ double
        }
    }

    namespace simulation {
        class Simulator {
            -List~Source~ sources
            -List~Device~ devices
            -Buffer buffer
            -PlacementDispatcher placementDispatcher
            -SelectionDispatcher selectionDispatcher
            -Statistics statistics
            -List~SimulationListener~ listeners
            -double currentTime
            +step() List~SimulationEvent~
            +run()
            +hasNextEvent() boolean
            +addListener(SimulationListener listener)
            -handleArrival(Source source, List~SimulationEvent~ events)
            -handleServiceEnd(Device device, List~SimulationEvent~ events)
        }

        class SimulationEvent {
            <<record>>
            +double time
            +EventType type
            +Request request
            +int deviceId
            +String detail
        }

        class EventType {
            <<enumeration>>
            GENERATED
            SENT_TO_DEVICE
            SENT_TO_BUFFER
            REFUSED
            PACKET_FORMED
            TAKEN_FROM_PACKET
            SERVICE_FINISHED
        }

        class SimulationListener {
            <<interface>>
            +onEvent(SimulationEvent event)
        }
    }

    namespace app {
        class SimulationConfig {
            <<record>>
            +defaults()$ SimulationConfig
            +buildSimulator() Simulator
            +load() double
        }

        class StepModeView {
            +render(int stepNumber, List~SimulationEvent~ events, Simulator sim)$ String
        }

        class Main {
            +main(String[] args)$
        }
    }

    Simulator "1" o-- "1..*" Source : sources
    Simulator "1" o-- "1..*" Device : devices
    Simulator "1" *-- "1" Buffer
    Simulator "1" *-- "1" PlacementDispatcher
    Simulator "1" *-- "1" SelectionDispatcher
    Simulator "1" *-- "1" Statistics
    Simulator "1" o-- "0..*" SimulationListener : notifies
    Simulator ..> SimulationEvent : creates

    Source ..> Request : creates
    Device "1" --> "0..1" Request : currentRequest
    Request --> RequestStatus
    Device --> DeviceStatus
    Buffer "1" o-- "0..capacity" Request : slots

    SelectionDispatcher "1" --> "1" Buffer : Д2Б5
    SelectionDispatcher "1" --> "1..*" Device : Д2П2
    PlacementDispatcher "1" --> "1" Buffer : Д1ОЗ3, Д1ОО2

    SimulationEvent --> EventType
    SimulationListener ..> SimulationEvent : receives

    SimulationConfig ..> Simulator : builds
    StepModeView ..> Simulator : reads
    Main ..> SimulationConfig : uses
    Main ..> StepModeView : uses
